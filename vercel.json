{
  "version": 2,
  "buildCommand": "cd frontend && npm install --include=dev && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?__subpath="
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__subpath=$1"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py?__subpath=docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py?__subpath=openapi.json"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
